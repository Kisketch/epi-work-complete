  2 |        (-97168, 52265) |              1.97031260821e-97 |         1.0316732698e-16
  3 |       (-128937, 69353) |              5.17876430236e-97 |        1.36897802124e-16
  4 |       (-160706, 86441) |               2.9644884861e-97 |        1.70628277268e-16

