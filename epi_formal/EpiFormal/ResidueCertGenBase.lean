/-!
# Generic integer checkers for N-cell transfer-operator certificates (core Lean, no Mathlib)

Boolean checkers evaluated by the kernel (`decide +kernel`) on data generated by
`verification/emit_cert_gen.py`. Soundness (Boolean check ⇒ `dimH` bound) is proved once,
generically, in `EpiFormal/ResidueCertGenSound.lean`.

Conventions (all natural numbers): grid `N`, digits `a = m*k + r` (`k < K`), exponent
`2s = p/q`, scale `S`. A certificate row `j` is a list of `K` coefficients.
* upper side: `hi_k ≥ S * ((a*N + j)/N)^(-p/q)`, cell value `vec[cellAt N a (j+1)]`;
* lower side: `lo_k ≤ S * ((a*N + j + 1)/N)^(-p/q)`, cell value `vec[cellAt N a j]`.
The vector `vec` is non-increasing, so these cell values are the max / min of `vec` over the
image cell.
-/

namespace ResidueCertGen

/-- `binOf N (1 / (a + e/N))` in closed form: `min (N-1) ⌊N² / (aN + e)⌋`. -/
def cellAt (N a e : Nat) : Nat := min (N - 1) (N * N / (a * N + e))

/-- `antiOK l` iff `l` is non-increasing. -/
def antiOK : List Nat → Bool
  | a :: b :: t => Nat.ble b a && antiOK (b :: t)
  | _ => true

/-- `Σ_i c_i * vec[cellAt N (m(k+i)+r) (j+e)]`. -/
def rowSum (vec : List Nat) (N m r j e : Nat) : List Nat → Nat → Nat
  | [], _ => 0
  | c :: t, k => c * vec.getD (cellAt N (m * k + r) (j + e)) 0 + rowSum vec N m r j e t (k + 1)

/-- upper power check: `S^q * N^p ≤ c^q * (aN + j)^p` for every coefficient. -/
def powU (N m r p q S j : Nat) : List Nat → Nat → Bool
  | [], _ => true
  | c :: t, k => Nat.ble (S ^ q * N ^ p) (c ^ q * ((m * k + r) * N + j) ^ p)
      && powU N m r p q S j t (k + 1)

/-- lower power check: `c^q * (aN + j + 1)^p ≤ S^q * N^p` for every coefficient. -/
def powL (N m r p q S j : Nat) : List Nat → Nat → Bool
  | [], _ => true
  | c :: t, k => Nat.ble (c ^ q * ((m * k + r) * N + j + 1) ^ p) (S ^ q * N ^ p)
      && powL N m r p q S j t (k + 1)

/-- upper row: `Σ hi_k v[cellAt (j+1)] + tail * v₀ < S * v_j`, plus length and powers. -/
def rowU (vec : List Nat) (N m r K p q S tail j : Nat) (c : List Nat) : Bool :=
  c.length == K && powU N m r p q S j c 0 &&
    Nat.blt (rowSum vec N m r j 1 c 0 + tail * vec.getD 0 0) (S * vec.getD j 0)

/-- lower row: `S * v_j < Σ lo_k v[cellAt j] + tail * v₀`, plus length and powers. -/
def rowL (vec : List Nat) (N m r K p q S tail j : Nat) (c : List Nat) : Bool :=
  c.length == K && powL N m r p q S j c 0 &&
    Nat.blt (S * vec.getD j 0) (rowSum vec N m r j 0 c 0 + tail * vec.getD 0 0)

/-- all consecutive rows from `j`. -/
def allU (vec : List Nat) (N m r K p q S tail : Nat) : Nat → List (List Nat) → Bool
  | _, [] => true
  | j, c :: t => rowU vec N m r K p q S tail j c && allU vec N m r K p q S tail (j + 1) t

def allL (vec : List Nat) (N m r K p q S tail : Nat) : Nat → List (List Nat) → Bool
  | _, [] => true
  | j, c :: t => rowL vec N m r K p q S tail j c && allL vec N m r K p q S tail (j + 1) t

/-- vector checks: length `N`, non-increasing, entries `≥ 1`. -/
def vecOK (vec : List Nat) (N : Nat) : Bool :=
  vec.length == N && antiOK vec && vec.all (fun x => decide (1 ≤ x))

/-- upper tail: `u ≥ S * (m(K-1)+r)^(-(p-q)/q)` and `u * q ≤ tail * m * (p-q)`. -/
def tailU (m r K p q S tail u : Nat) : Bool :=
  Nat.ble (S ^ q) (u ^ q * (m * (K - 1) + r) ^ (p - q)) && Nat.ble (u * q) (tail * m * (p - q))

/-- lower tail: `l ≤ S * (mK+r+1)^(-(p-q)/q)`, `u ≥ S * (m Kmax + r + 1)^(-(p-q)/q)`,
    and `tail * m * (p-q) + u * q ≤ l * q`. -/
def tailL (m r K Kmax p q S tail l u : Nat) : Bool :=
  Nat.ble (l ^ q * (m * K + r + 1) ^ (p - q)) (S ^ q) &&
    Nat.ble (S ^ q) (u ^ q * (m * Kmax + r + 1) ^ (p - q)) &&
    Nat.ble (tail * m * (p - q) + u * q) (l * q)

end ResidueCertGen
