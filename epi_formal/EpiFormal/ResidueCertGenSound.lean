import EpiFormal.TransferOperatorDim
import EpiFormal.ResidueRpowBridge_Draft
import EpiFormal.ResidueCertGenBase

/-!
# Soundness of the generic integer certificate checkers (`ResidueCertGenBase`)

If the kernel-evaluated Boolean checks of `ResidueCertGenBase` hold for a vector `vec` and a
coefficient table `row`, then (with `2s = p/q`)
* `dimH_le_of_certU`: `dimH F_{m,r} ≤ s`   (via `TransferOperatorDim.step_cert_upper_sound`);
* `le_dimH_of_certL`: `s ≤ dimH F_{m,r}`   (via `TransferOperatorDim.step_cert_lower_sound`).

The proof is generic in all parameters; concrete certificates only supply the `decide +kernel`
facts (`vec_ok`, `tail_ok`, `tab_ok`) generated by `verification/emit_cert_gen.py`.
Key observation: `vec` is non-increasing, so on every image cell `[binLeft, binRight]` its
maximum is `vec[binLeft]` and its minimum is `vec[binRight]`; no max/min tables are needed.
-/

namespace ResidueCertGen

open Finset
open scoped ENNReal

/-! ### Part A: Boolean checks → propositions -/

lemma antiOK_getD : ∀ (l : List ℕ), antiOK l = true →
    ∀ i i', i ≤ i' → i' < l.length → l.getD i' 0 ≤ l.getD i 0
  | [], _, _, _, _, h => by simp at h
  | [_], _, i, i', hii', h => by
      have h1 : i' < 1 := by simpa using h
      obtain rfl : i' = 0 := by omega
      obtain rfl : i = 0 := by omega
      exact le_rfl
  | a :: b :: t, h, i, i', hii', hlt => by
      simp only [antiOK, Bool.and_eq_true, Nat.ble_eq] at h
      obtain ⟨hba, ht⟩ := h
      have IH := antiOK_getD (b :: t) ht
      rcases i with _ | i
      · rcases i' with _ | i'
        · exact le_rfl
        · have h2 := IH 0 i' (Nat.zero_le _) (by simp at hlt ⊢; omega)
          simp only [List.getD_cons_succ, List.getD_cons_zero] at h2 ⊢
          omega
      · rcases i' with _ | i'
        · omega
        · simp only [List.getD_cons_succ]
          exact IH i i' (by omega) (by simp at hlt ⊢; omega)

lemma vecOK_spec {vec : List ℕ} {N : ℕ} (h : vecOK vec N = true) :
    vec.length = N ∧ antiOK vec = true ∧ ∀ i < N, 1 ≤ vec.getD i 0 := by
  simp only [vecOK, Bool.and_eq_true, beq_iff_eq] at h
  obtain ⟨⟨hlen, hanti⟩, hall⟩ := h
  refine ⟨hlen, hanti, fun i hi => ?_⟩
  rw [List.all_eq_true] at hall
  have hlt : i < vec.length := by rw [hlen]; exact hi
  have hmem : vec.getD i 0 ∈ vec := by
    rw [List.getD_eq_getElem _ _ hlt]; exact List.getElem_mem hlt
  simpa using hall _ hmem

lemma rowSum_eq (vec : List ℕ) (N m r j e : ℕ) : ∀ (l : List ℕ) (k0 : ℕ),
    rowSum vec N m r j e l k0 =
      ∑ i ∈ range l.length, l.getD i 0 * vec.getD (cellAt N (m * (k0 + i) + r) (j + e)) 0
  | [], _ => by simp [rowSum]
  | c :: t, k0 => by
      rw [rowSum, rowSum_eq vec N m r j e t (k0 + 1), List.length_cons,
        Finset.sum_range_succ', add_comm]
      simp only [List.getD_cons_succ, List.getD_cons_zero, add_zero]
      congr 1
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [show k0 + (i + 1) = k0 + 1 + i by omega]

lemma powU_spec (N m r p q S j : ℕ) : ∀ (l : List ℕ) (k0 : ℕ), powU N m r p q S j l k0 = true →
    ∀ i < l.length, S ^ q * N ^ p ≤ (l.getD i 0) ^ q * ((m * (k0 + i) + r) * N + j) ^ p
  | [], _, _, i, hi => by simp at hi
  | c :: t, k0, hok, i, hi => by
      simp only [powU, Bool.and_eq_true, Nat.ble_eq] at hok
      rcases i with _ | i
      · simpa using hok.1
      · simp only [List.getD_cons_succ]
        have h2 := powU_spec N m r p q S j t (k0 + 1) hok.2 i (by simp at hi; omega)
        rwa [show k0 + (i + 1) = k0 + 1 + i by omega]

lemma powL_spec (N m r p q S j : ℕ) : ∀ (l : List ℕ) (k0 : ℕ), powL N m r p q S j l k0 = true →
    ∀ i < l.length, (l.getD i 0) ^ q * ((m * (k0 + i) + r) * N + j + 1) ^ p ≤ S ^ q * N ^ p
  | [], _, _, i, hi => by simp at hi
  | c :: t, k0, hok, i, hi => by
      simp only [powL, Bool.and_eq_true, Nat.ble_eq] at hok
      rcases i with _ | i
      · simpa using hok.1
      · simp only [List.getD_cons_succ]
        have h2 := powL_spec N m r p q S j t (k0 + 1) hok.2 i (by simp at hi; omega)
        rwa [show k0 + (i + 1) = k0 + 1 + i by omega]

lemma allU_spec (vec : List ℕ) (N m r K p q S tail : ℕ) :
    ∀ (T : List (List ℕ)) (j0 : ℕ), allU vec N m r K p q S tail j0 T = true →
      ∀ i < T.length, rowU vec N m r K p q S tail (j0 + i) (T.getD i []) = true
  | [], _, _, i, hi => by simp at hi
  | c :: t, j0, hok, i, hi => by
      simp only [allU, Bool.and_eq_true] at hok
      rcases i with _ | i
      · simpa using hok.1
      · have h2 := allU_spec vec N m r K p q S tail t (j0 + 1) hok.2 i (by simp at hi; omega)
        simp only [List.getD_cons_succ]
        rwa [show j0 + (i + 1) = j0 + 1 + i by omega]

lemma allL_spec (vec : List ℕ) (N m r K p q S tail : ℕ) :
    ∀ (T : List (List ℕ)) (j0 : ℕ), allL vec N m r K p q S tail j0 T = true →
      ∀ i < T.length, rowL vec N m r K p q S tail (j0 + i) (T.getD i []) = true
  | [], _, _, i, hi => by simp at hi
  | c :: t, j0, hok, i, hi => by
      simp only [allL, Bool.and_eq_true] at hok
      rcases i with _ | i
      · simpa using hok.1
      · have h2 := allL_spec vec N m r K p q S tail t (j0 + 1) hok.2 i (by simp at hi; omega)
        simp only [List.getD_cons_succ]
        rwa [show j0 + (i + 1) = j0 + 1 + i by omega]

/-- Chunked tables: `N = C * nc` rows split into `nc` chunks of `C` rows. -/
lemma rows_of_chunksU {vec : List ℕ} {N m r K p q S tail C nc : ℕ} (tab : ℕ → List (List ℕ))
    (hlen : ∀ c < nc, (tab c).length = C)
    (hok : ∀ c < nc, allU vec N m r K p q S tail (C * c) (tab c) = true) :
    ∀ j < C * nc, rowU vec N m r K p q S tail j ((tab (j / C)).getD (j % C) []) = true := by
  intro j hj
  have hC : 0 < C := by rcases Nat.eq_zero_or_pos C with h | h <;> [simp [h] at hj; exact h]
  have hc : j / C < nc := by rwa [Nat.div_lt_iff_lt_mul hC, mul_comm]
  have h := allU_spec vec N m r K p q S tail (tab (j / C)) (C * (j / C)) (hok _ hc) (j % C)
    (by rw [hlen _ hc]; exact Nat.mod_lt _ hC)
  rwa [Nat.div_add_mod j C] at h

lemma rows_of_chunksL {vec : List ℕ} {N m r K p q S tail C nc : ℕ} (tab : ℕ → List (List ℕ))
    (hlen : ∀ c < nc, (tab c).length = C)
    (hok : ∀ c < nc, allL vec N m r K p q S tail (C * c) (tab c) = true) :
    ∀ j < C * nc, rowL vec N m r K p q S tail j ((tab (j / C)).getD (j % C) []) = true := by
  intro j hj
  have hC : 0 < C := by rcases Nat.eq_zero_or_pos C with h | h <;> [simp [h] at hj; exact h]
  have hc : j / C < nc := by rwa [Nat.div_lt_iff_lt_mul hC, mul_comm]
  have h := allL_spec vec N m r K p q S tail (tab (j / C)) (C * (j / C)) (hok _ hc) (j % C)
    (by rw [hlen _ hc]; exact Nat.mod_lt _ hC)
  rwa [Nat.div_add_mod j C] at h

/-! ### Part B: grid-index bridge -/

open TransferOperatorDim in
lemma binOf_inv_val (N a e : ℕ) (hN : 1 ≤ N) (hpos : 0 < a * N + e) :
    (binOf N hN (1 / ((a : ℝ) + (e : ℝ) / (N : ℝ)))).val = cellAt N a e := by
  simp only [binOf, cellAt]
  congr 1
  have hNR : (0 : ℝ) < (N : ℝ) := by exact_mod_cast (by omega : 0 < N)
  have hposR : (0 : ℝ) < ((a * N + e : ℕ) : ℝ) := by exact_mod_cast hpos
  have hx : (N : ℝ) * (1 / ((a : ℝ) + (e : ℝ) / (N : ℝ)))
      = ((N * N : ℕ) : ℝ) / ((a * N + e : ℕ) : ℝ) := by
    push_cast at hposR ⊢
    have hden : (a : ℝ) + (e : ℝ) / (N : ℝ) = ((a : ℝ) * N + e) / N := by
      field_simp
    rw [hden]
    field_simp
  rw [hx, Nat.floor_div_eq_div]

open TransferOperatorDim in
lemma binLeft_val (N a : ℕ) (hN : 1 ≤ N) (j : Fin N) :
    (binLeft N hN a j).val = cellAt N a (j.1 + 1) := by
  have h := binOf_inv_val N a (j.1 + 1) hN (by omega)
  simpa [binLeft] using h

open TransferOperatorDim in
lemma binRight_val (N a : ℕ) (hN : 1 ≤ N) (ha : 1 ≤ a) (j : Fin N) :
    (binRight N hN a j).val = cellAt N a (j.1 + 0) := by
  have h := binOf_inv_val N a j.1 hN (by nlinarith)
  simpa [binRight] using h

/-! ### Part C: real-number consequences of the integer checks -/

lemma two_s_eq (p q : ℕ) (hq : 1 ≤ q) :
    2 * ((p : ℝ) / (2 * q)) = (p : ℝ) / (q : ℝ) := by
  have : (q : ℝ) ≠ 0 := by exact_mod_cast (by omega : q ≠ 0)
  field_simp

lemma one_sub_two_s (p q : ℕ) (hq : 1 ≤ q) (hpq : q < p) :
    1 - 2 * ((p : ℝ) / (2 * q)) = -(((p - q : ℕ) : ℝ) / (q : ℝ)) := by
  rw [two_s_eq p q hq, Nat.cast_sub hpq.le]
  have : (q : ℝ) ≠ 0 := by exact_mod_cast (by omega : q ≠ 0)
  field_simp
  ring

lemma two_s_sub_one (p q : ℕ) (hq : 1 ≤ q) (hpq : q < p) :
    2 * ((p : ℝ) / (2 * q)) - 1 = ((p - q : ℕ) : ℝ) / (q : ℝ) := by
  have := one_sub_two_s p q hq hpq
  linarith

lemma half_lt_s (p q : ℕ) (hq : 1 ≤ q) (hpq : q < p) : 1 / 2 < (p : ℝ) / (2 * q) := by
  have hqR : (0 : ℝ) < q := by exact_mod_cast (by omega : 0 < q)
  have hpqR : (q : ℝ) < p := by exact_mod_cast hpq
  rw [div_lt_div_iff₀ (by norm_num) (by positivity)]
  linarith

/-- upper per-digit power: `(a + j/N)^(-2s) ≤ c/S`. -/
lemma term_upper {N m r p q S j k c : ℕ} (hN : 1 ≤ N) (hq : 1 ≤ q) (hS : 0 < S)
    (hc : S ^ q * N ^ p ≤ c ^ q * ((m * k + r) * N + j) ^ p) (hpos : 0 < (m * k + r) * N + j) :
    (((m * k + r : ℕ) : ℝ) + (j : ℝ) / (N : ℝ)) ^ (-(2 * ((p : ℝ) / (2 * q))))
      ≤ (c : ℝ) / (S : ℝ) := by
  have hb := enclose_rpow_upper (num := (m * k + r) * N + j) (den := N) (hi := c) (SCALE := S)
    (p := p) (q := q) hq (by omega) hpos hS hc
  have hNR : (0 : ℝ) < (N : ℝ) := by exact_mod_cast (by omega : 0 < N)
  have hbase : ((((m * k + r) * N + j : ℕ) : ℝ) / (N : ℝ))
      = ((m * k + r : ℕ) : ℝ) + (j : ℝ) / (N : ℝ) := by
    push_cast; field_simp
  rw [hbase] at hb
  rwa [two_s_eq p q hq]

/-- lower per-digit power: `c/S ≤ (a + (j+1)/N)^(-2s)`. -/
lemma term_lower {N m r p q S j k c : ℕ} (hN : 1 ≤ N) (hq : 1 ≤ q) (hS : 0 < S)
    (hc : c ^ q * ((m * k + r) * N + j + 1) ^ p ≤ S ^ q * N ^ p) :
    (c : ℝ) / (S : ℝ) ≤
      (((m * k + r : ℕ) : ℝ) + ((j : ℝ) + 1) / (N : ℝ)) ^ (-(2 * ((p : ℝ) / (2 * q)))) := by
  have hb := enclose_rpow_lower (num := (m * k + r) * N + j + 1) (den := N) (lo := c)
    (SCALE := S) (p := p) (q := q) hq (by omega) (by omega) hS hc
  have hNR : (0 : ℝ) < (N : ℝ) := by exact_mod_cast (by omega : 0 < N)
  have hbase : ((((m * k + r) * N + j + 1 : ℕ) : ℝ) / (N : ℝ))
      = ((m * k + r : ℕ) : ℝ) + ((j : ℝ) + 1) / (N : ℝ) := by
    push_cast; field_simp; ring
  rw [hbase] at hb
  rwa [two_s_eq p q hq]

lemma tail_upper {m r K p q S tail u : ℕ} (hm : 1 ≤ m) (hq : 1 ≤ q) (hpq : q < p) (hS : 0 < S)
    (hpos : 0 < m * (K - 1) + r) (h : tailU m r K p q S tail u = true) :
    (((m * (K - 1) + r : ℕ) : ℝ) ^ (1 - 2 * ((p : ℝ) / (2 * q)))) /
        ((m : ℝ) * (2 * ((p : ℝ) / (2 * q)) - 1)) ≤ (tail : ℝ) / (S : ℝ) := by
  simp only [tailU, Bool.and_eq_true, Nat.ble_eq] at h
  obtain ⟨h1, h2⟩ := h
  have hb := enclose_rpow_upper (num := m * (K - 1) + r) (den := 1) (hi := u) (SCALE := S)
    (p := p - q) (q := q) hq (by norm_num) hpos hS (by simpa using h1)
  rw [Nat.cast_one, div_one] at hb
  rw [one_sub_two_s p q hq hpq, two_s_sub_one p q hq hpq]
  have hSR : (0 : ℝ) < S := by exact_mod_cast hS
  have hqR : (0 : ℝ) < q := by exact_mod_cast (by omega : 0 < q)
  have hmR : (0 : ℝ) < m := by exact_mod_cast (by omega : 0 < m)
  have hdR : (0 : ℝ) < ((p - q : ℕ) : ℝ) := by exact_mod_cast (by omega : 0 < p - q)
  have h2R : (u : ℝ) * q ≤ (tail : ℝ) * m * ((p - q : ℕ) : ℝ) := by exact_mod_cast h2
  rw [div_le_div_iff₀ (by positivity) hSR]
  calc _ ≤ (u : ℝ) / S * S := by gcongr
    _ = u := div_mul_cancel₀ _ hSR.ne'
    _ ≤ tail * (m * (((p - q : ℕ) : ℝ) / q)) := by
        have he : (tail : ℝ) * (m * (((p - q : ℕ) : ℝ) / q))
            = (tail * m * ((p - q : ℕ) : ℝ)) / q := by ring
        rw [he, le_div_iff₀ hqR]; linarith

lemma tail_lower {m r K Kmax p q S tail l u : ℕ} (hm : 1 ≤ m) (hq : 1 ≤ q) (hpq : q < p)
    (hS : 0 < S) (h : tailL m r K Kmax p q S tail l u = true) :
    (tail : ℝ) / (S : ℝ) ≤
      ((((m * K + r + 1 : ℕ) : ℝ) ^ (1 - 2 * ((p : ℝ) / (2 * q)))) -
        (((m * Kmax + r + 1 : ℕ) : ℝ) ^ (1 - 2 * ((p : ℝ) / (2 * q))))) /
        ((m : ℝ) * (2 * ((p : ℝ) / (2 * q)) - 1)) := by
  simp only [tailL, Bool.and_eq_true, Nat.ble_eq] at h
  obtain ⟨⟨h1, h2⟩, h3⟩ := h
  have hA := enclose_rpow_lower (num := m * K + r + 1) (den := 1) (lo := l) (SCALE := S)
    (p := p - q) (q := q) hq (by norm_num) (by omega) hS (by simpa using h1)
  have hB := enclose_rpow_upper (num := m * Kmax + r + 1) (den := 1) (hi := u) (SCALE := S)
    (p := p - q) (q := q) hq (by norm_num) (by omega) hS (by simpa using h2)
  rw [Nat.cast_one, div_one] at hA hB
  rw [one_sub_two_s p q hq hpq, two_s_sub_one p q hq hpq]
  have hSR : (0 : ℝ) < S := by exact_mod_cast hS
  have hqR : (0 : ℝ) < q := by exact_mod_cast (by omega : 0 < q)
  have hmR : (0 : ℝ) < m := by exact_mod_cast (by omega : 0 < m)
  have hdR : (0 : ℝ) < ((p - q : ℕ) : ℝ) := by exact_mod_cast (by omega : 0 < p - q)
  have h3R : (tail : ℝ) * m * ((p - q : ℕ) : ℝ) + u * q ≤ l * q := by exact_mod_cast h3
  rw [le_div_iff₀ (by positivity)]
  have key : (tail : ℝ) / S * (m * (((p - q : ℕ) : ℝ) / q)) ≤ (l : ℝ) / S - (u : ℝ) / S := by
    have he : (tail : ℝ) / S * (m * (((p - q : ℕ) : ℝ) / q))
        = (tail * m * ((p - q : ℕ) : ℝ)) / (S * q) := by field_simp
    have he2 : (l : ℝ) / S - (u : ℝ) / S = (l * q - u * q) / (S * q) := by field_simp
    rw [he, he2]
    exact div_le_div_of_nonneg_right (by linarith) (by positivity)
  linarith

/-! ### Part D: the generic dimension bounds -/

open TransferOperatorDim ResidueModGeneral in
/-- **Upper bound from a checked certificate.** -/
theorem dimH_le_of_certU {m r K p q N S tail u : ℕ} {vec : List ℕ} (row : ℕ → List ℕ)
    (hm : 1 ≤ m) (hr : 1 ≤ r) (hK : 1 ≤ K) (hN : 1 ≤ N) (hcut : N + 1 ≤ m * K + r)
    (hq : 1 ≤ q) (hpq : q < p) (hS : 0 < S)
    (hvec : vecOK vec N = true) (htail : tailU m r K p q S tail u = true)
    (hrows : ∀ j < N, rowU vec N m r K p q S tail j (row j) = true) :
    dimH (residueConstSet m r) ≤ ENNReal.ofReal ((p : ℝ) / (2 * q)) := by
  obtain ⟨hlen, hanti, hposv⟩ := vecOK_spec hvec
  set s : ℝ := (p : ℝ) / (2 * q) with hs_def
  let v : Fin N → ℝ≥0∞ := fun j => ((vec.getD j.1 0 : ℕ) : ℝ≥0∞)
  have hSR : (0 : ℝ) < S := by exact_mod_cast hS
  refine step_cert_upper_sound hm hr hK hN hcut (half_lt_s p q hq hpq) v ?_ ?_
    (fun j k => v (binLeft N hN (m * k + r) j)) ?_ ?_
  · intro j
    have := hposv j.1 j.2
    show (0 : ℝ≥0∞) < ((vec.getD j.1 0 : ℕ) : ℝ≥0∞)
    exact_mod_cast (by omega : 0 < vec.getD j.1 0)
  · intro j
    exact (ENNReal.natCast_ne_top _).lt_top
  · intro j k _ i hL _
    have hL' : (binLeft N hN (m * k + r) j).val ≤ i.val := hL
    show ((vec.getD i.1 0 : ℕ) : ℝ≥0∞) ≤ ((vec.getD (binLeft N hN (m * k + r) j).1 0 : ℕ) : ℝ≥0∞)
    exact_mod_cast antiOK_getD vec hanti _ _ hL' (by rw [hlen]; exact i.2)
  · intro j
    have hrow := hrows j.1 j.2
    simp only [rowU, Bool.and_eq_true, beq_iff_eq, Nat.blt_eq] at hrow
    obtain ⟨⟨hclen, hpow⟩, hlt⟩ := hrow
    set c := row j.1 with hc_def
    have hbl : ∀ k, (binLeft N hN (m * k + r) j).val = cellAt N (m * (0 + k) + r) (j.1 + 1) :=
      fun k => by rw [zero_add]; exact binLeft_val N _ hN j
    set R : ℝ := (∑ k ∈ range K,
        (vec.getD (cellAt N (m * (0 + k) + r) (j.1 + 1)) 0 : ℝ) * ((c.getD k 0 : ℝ) / S)) +
        (vec.getD 0 0 : ℝ) * ((tail : ℝ) / S) with hR
    have hRle : R ≤ (vec.getD j.1 0 : ℝ) := by
      have hX : ((rowSum vec N m r j.1 1 c 0 + tail * vec.getD 0 0 : ℕ) : ℝ)
          ≤ ((S * vec.getD j.1 0 : ℕ) : ℝ) := by exact_mod_cast hlt.le
      have hRX : R = ((rowSum vec N m r j.1 1 c 0 + tail * vec.getD 0 0 : ℕ) : ℝ) / S := by
        rw [hR, rowSum_eq, hclen]
        push_cast
        rw [add_div, Finset.sum_div]
        congr 1
        · exact Finset.sum_congr rfl fun k _ => by ring
        · ring
      rw [hRX, div_le_iff₀ hSR]
      push_cast at hX ⊢
      linarith
    have hnn : ∀ k ∈ range K,
        0 ≤ (vec.getD (cellAt N (m * (0 + k) + r) (j.1 + 1)) 0 : ℝ) * ((c.getD k 0 : ℝ) / S) :=
      fun k _ => by positivity
    calc _ ≤ (∑ k ∈ range K, ENNReal.ofReal
            ((vec.getD (cellAt N (m * (0 + k) + r) (j.1 + 1)) 0 : ℝ) * ((c.getD k 0 : ℝ) / S))) +
          ENNReal.ofReal ((vec.getD 0 0 : ℝ) * ((tail : ℝ) / S)) := by
          gcongr with k hk
          · have hk' : k < K := Finset.mem_range.mp hk
            have hck := powU_spec N m r p q S j.1 c 0 hpow k (by rw [hclen]; exact hk')
            rw [zero_add] at hck
            have ht := term_upper (k := k) (j := j.1) hN hq hS hck
              (Nat.add_pos_left (Nat.mul_pos (by omega) (by omega)) _)
            simp only [v, hbl k]
            rw [← ENNReal.ofReal_natCast, ← ENNReal.ofReal_mul (by positivity)]
            exact ENNReal.ofReal_le_ofReal
              (mul_le_mul_of_nonneg_left (by simpa using ht) (by positivity))
          · simp only [v]
            rw [← ENNReal.ofReal_natCast, ← ENNReal.ofReal_mul (by positivity)]
            exact ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left
              (tail_upper hm hq hpq hS (by omega) htail) (by positivity))
      _ = ENNReal.ofReal R := by
          rw [hR, ENNReal.ofReal_add (Finset.sum_nonneg hnn) (by positivity),
            ENNReal.ofReal_sum_of_nonneg hnn]
      _ ≤ ENNReal.ofReal (vec.getD j.1 0 : ℝ) := ENNReal.ofReal_le_ofReal hRle
      _ = v j := ENNReal.ofReal_natCast _

open TransferOperatorDim ResidueModGeneral in
/-- **Lower bound from a checked certificate.** -/
theorem le_dimH_of_certL {m r K Kmax p q N S tail l u : ℕ} {vec : List ℕ} (row : ℕ → List ℕ)
    (hm : 1 ≤ m) (hr : 1 ≤ r) (hK : 1 ≤ K) (hKK : K ≤ Kmax) (hN : 1 ≤ N)
    (hcut : N + 1 ≤ m * K + r) (hq : 1 ≤ q) (hpq : q < p) (hS : 0 < S)
    (hvec : vecOK vec N = true) (htail : tailL m r K Kmax p q S tail l u = true)
    (hrows : ∀ j < N, rowL vec N m r K p q S tail j (row j) = true) :
    ENNReal.ofReal ((p : ℝ) / (2 * q)) ≤ dimH (residueConstSet m r) := by
  obtain ⟨hlen, hanti, hposv⟩ := vecOK_spec hvec
  let v : Fin N → ℝ≥0∞ := fun j => ((vec.getD j.1 0 : ℕ) : ℝ≥0∞)
  have hSR : (0 : ℝ) < S := by exact_mod_cast hS
  refine step_cert_lower_sound hm hr hK hKK hN hcut (half_lt_s p q hq hpq) v ?_ ?_
    (fun j k => v (binRight N hN (m * k + r) j)) ?_ ?_
  · intro j
    have := hposv j.1 j.2
    show (0 : ℝ≥0∞) < ((vec.getD j.1 0 : ℕ) : ℝ≥0∞)
    exact_mod_cast (by omega : 0 < vec.getD j.1 0)
  · intro j
    exact (ENNReal.natCast_ne_top _).lt_top
  · intro j k _ i _ hR
    have hR' : i.val ≤ (binRight N hN (m * k + r) j).val := hR
    show ((vec.getD (binRight N hN (m * k + r) j).1 0 : ℕ) : ℝ≥0∞) ≤ ((vec.getD i.1 0 : ℕ) : ℝ≥0∞)
    exact_mod_cast antiOK_getD vec hanti _ _ hR'
      (by rw [hlen]; exact (binRight N hN (m * k + r) j).2)
  · intro j
    have hrow := hrows j.1 j.2
    simp only [rowL, Bool.and_eq_true, beq_iff_eq, Nat.blt_eq] at hrow
    obtain ⟨⟨hclen, hpow⟩, hlt⟩ := hrow
    set c := row j.1 with hc_def
    have hbr : ∀ k, (binRight N hN (m * k + r) j).val = cellAt N (m * (0 + k) + r) (j.1 + 0) :=
      fun k => by rw [zero_add]; exact binRight_val N _ hN (by nlinarith) j
    set R : ℝ := (∑ k ∈ range K,
        (vec.getD (cellAt N (m * (0 + k) + r) (j.1 + 0)) 0 : ℝ) * ((c.getD k 0 : ℝ) / S)) +
        (vec.getD 0 0 : ℝ) * ((tail : ℝ) / S) with hR
    have hRge : (vec.getD j.1 0 : ℝ) ≤ R := by
      have hX : ((S * vec.getD j.1 0 : ℕ) : ℝ)
          ≤ ((rowSum vec N m r j.1 0 c 0 + tail * vec.getD 0 0 : ℕ) : ℝ) := by
        exact_mod_cast hlt.le
      have hRX : R = ((rowSum vec N m r j.1 0 c 0 + tail * vec.getD 0 0 : ℕ) : ℝ) / S := by
        rw [hR, rowSum_eq, hclen]
        push_cast
        rw [add_div, Finset.sum_div]
        congr 1
        · exact Finset.sum_congr rfl fun k _ => by ring
        · ring
      rw [hRX, le_div_iff₀ hSR]
      push_cast at hX ⊢
      linarith
    have hnn : ∀ k ∈ range K,
        0 ≤ (vec.getD (cellAt N (m * (0 + k) + r) (j.1 + 0)) 0 : ℝ) * ((c.getD k 0 : ℝ) / S) :=
      fun k _ => by positivity
    calc v j = ENNReal.ofReal (vec.getD j.1 0 : ℝ) := (ENNReal.ofReal_natCast _).symm
      _ ≤ ENNReal.ofReal R := ENNReal.ofReal_le_ofReal hRge
      _ = (∑ k ∈ range K, ENNReal.ofReal
            ((vec.getD (cellAt N (m * (0 + k) + r) (j.1 + 0)) 0 : ℝ) * ((c.getD k 0 : ℝ) / S))) +
          ENNReal.ofReal ((vec.getD 0 0 : ℝ) * ((tail : ℝ) / S)) := by
          rw [hR, ENNReal.ofReal_add (Finset.sum_nonneg hnn) (by positivity),
            ENNReal.ofReal_sum_of_nonneg hnn]
      _ ≤ _ := by
          gcongr with k hk
          · have hk' : k < K := Finset.mem_range.mp hk
            have hck := powL_spec N m r p q S j.1 c 0 hpow k (by rw [hclen]; exact hk')
            rw [zero_add] at hck
            have ht := term_lower (k := k) (j := j.1) hN hq hS hck
            simp only [v, hbr k]
            rw [← ENNReal.ofReal_natCast, ← ENNReal.ofReal_mul (by positivity)]
            exact ENNReal.ofReal_le_ofReal
              (mul_le_mul_of_nonneg_left (by simpa using ht) (by positivity))
          · simp only [v]
            rw [← ENNReal.ofReal_natCast, ← ENNReal.ofReal_mul (by positivity)]
            exact ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left
              (tail_lower hm hq hpq hS htail) (by positivity))

end ResidueCertGen
